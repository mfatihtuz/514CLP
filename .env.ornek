# ============================================================
# Ortam yapılandırması — bu dosyayı .env olarak kopyalayıp doldurun.
# .env ASLA git'e girmez (.gitignore'dadır).
# ============================================================

# gelistirme | uretim
ORTAM=gelistirme

# Sitenin tam adresi (e-posta linkleri, QR ve ödeme callback'leri bunun üzerinden kurulur)
TABAN_URL=https://rezervasyon.mftyazilim.com

# ---- Veritabanı ----
# Üretim (Hostinger): mysql | Yerel geliştirme: sqlite
VT_SURUCU=sqlite
# MySQL için (Hostinger hPanel > Veritabanları ekranındaki değerler):
VT_SUNUCU=localhost
VT_AD=
VT_KULLANICI=
VT_SIFRE=
# SQLite için (varsayılan: veritabani/gelistirme.sqlite):
# VT_SQLITE_YOL=

# ---- Ödeme ----
# mock | iyzico  (uretim ortamında mock seçilirse uygulama açılışta hata verir)
ODEME_SAGLAYICI=mock
IYZICO_API_ANAHTARI=
IYZICO_GIZLI_ANAHTAR=
# Test: https://sandbox-api.iyzipay.com | Canlı: https://api.iyzipay.com
IYZICO_TEMEL_URL=https://sandbox-api.iyzipay.com

# ---- QR bilet imzası ----
# En az 32 karakterlik rastgele bir dizge üretin: php -r "echo bin2hex(random_bytes(24));"
QR_IMZA_ANAHTARI=

# ---- E-posta (Hostinger SMTP) ----
# hPanel > E-postalar bölümünden rezervasyon@mftyazilim.com gibi bir hesap açın.
SMTP_SUNUCU=smtp.hostinger.com
SMTP_PORT=465
SMTP_KULLANICI=
SMTP_SIFRE=
SMTP_GONDEREN_AD=Maç Gecesi Rezervasyon

# ---- Cron koruması ----
# Cron uç noktalarını dışarıdan tetiklenmeye karşı korur:
CRON_GIZLI_ANAHTAR=
